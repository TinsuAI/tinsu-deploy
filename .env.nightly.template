# Copy to .env.nightly on the box and fill in. .env.nightly is gitignored.
# `docker compose --env-file .env.nightly -f docker-compose.nightly.yml ...`
# (the scripts source it automatically).

COMPOSE_PROJECT_NAME=nightly

# --- External URLs (browser-facing, over Tailscale) ---
# DH issuer pin: NIGHTLY_DH_EXTERNAL_URL must be the URL the browser uses to
# reach nightly DH, AND it becomes DH `sso_issuer_url` + CO DATA_HUB_ISSUER_URL.
NIGHTLY_DH_EXTERNAL_URL=http://100.84.189.87:8764
NIGHTLY_CO_EXTERNAL_URL=http://100.84.189.87:8765

# --- Data Hub (nightly) ---
DH_HOST_PORT=8764
DH_POSTGRES_PASSWORD=__set_me__
DH_SEED_EMAIL=admin@data-hub.local
DH_SEED_PASSWORD=__set_me__

# --- CO (nightly) ---
CO_HOST_PORT=8765
CO_POSTGRES_PASSWORD=__set_me__
# Auto-managed: scripts/mint-nightly-token.sh re-mints this after each snapshot
# (the snapshot clobbers service_accounts with prod rows). Leave blank initially.
NIGHTLY_DH_SERVICE_TOKEN=

# --- Stable demo user (re-created after every snapshot by ensure-demo-user.sh) ---
DEMO_USER_EMAIL=demo@tinsu.ai
DEMO_USER_PASSWORD=__set_me__
DEMO_USER_NAME=Demo

# --- App source repos (nightly clones into ./src, independent of prod checkouts) ---
DH_REPO_URL=https://github.com/TinsuAI/data-hub.git
CO_REPO_URL=https://github.com/sgnjfk/barry-CO-bom-builder.git

# --- LLM (shared with prod — copy prod values) ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Prod source for snapshot — VERIFY these names on the box (docker ps / volume ls) ---
PROD_DH_DB_CONTAINER=data-hub-db-1
PROD_CO_DB_CONTAINER=co-db-1
PROD_DH_FILES_VOL=data-hub_appfiles
